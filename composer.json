{
    "name": "starring-jane/logging",
    "description": "Logging made for use inside laravel apps",
    "autoload": {
        "psr-4": {
            "StarringJane\\Logging\\": "src/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Verschoore",
            "email": "brian@starringjane.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel-notification-channels/microsoft-teams": "^2.2",
        "illuminate/support": "^12.0|^13.0",
        "monolog/monolog": "^3.4"
    },
    "require-dev": {
        "pestphp/pest": "^v4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StarringJane\\Logging\\LoggingServiceProvider",
                "NotificationChannels\\MicrosoftTeams\\MicrosoftTeamsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
